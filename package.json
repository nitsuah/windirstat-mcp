{
  "name": "windirstat-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) Server for Windows Disk Analyzer, Tiering, and Safe Cleanup",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "start:docker": "node mcp-server.js",
    "docker:build": "docker build -t windirstat-mcp .",
    "docker:run": "node mcp-server.js",
    "docker:stop": "docker stop windirstat-mcp-server --time=5 || true",
    "docker:clean": "docker rm -f windirstat-mcp-server 2>/dev/null || true && docker rmi windirstat-mcp 2>/dev/null || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0"
  },
  "devDependencies": {
    "vitest": "^2.1.1",
    "@vitest/coverage-v8": "^2.1.1"
  },
  "keywords": [
    "mcp",
    "disk-analyzer",
    "windirstat",
    "storage",
    "cleanup"
  ],
  "author": "Antigravity AI",
  "license": "MIT"
}
